{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/user_database.json",
      "destination": "/user_database.json"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/dashboard.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}